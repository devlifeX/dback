# Example environment for systemd (copy to /etc/dback/dback.env)

DBACK_DATA_DIR=/var/lib/dback
DBACK_PASSPHRASE_FILE=/etc/dback/passphrase
DBACK_API_TOKEN_FILE=/etc/dback/api-token
DBACK_LISTEN=127.0.0.1:14127
DBACK_WEB_ROOT=/usr/share/dback/web
DBACK_RATE_LIMIT_RPS=20
DBACK_RATE_LIMIT_BURST=40
DBACK_METRICS=true
DBACK_AUDIT_CAP=500

# Database (default: SQLite at DBACK_DATA_DIR/dback.db)
# DBACK_DB_DRIVER=sqlite
# DBACK_DB_DSN=/var/lib/dback/dback.db?_foreign_keys=on&_busy_timeout=5000

# MySQL example (server deployments)
# DBACK_DB_DRIVER=mysql
# DBACK_DB_DSN=dback:secret@tcp(127.0.0.1:3306)/dback?parseTime=true&multiStatements=true
# Or: DBACK_DB_HOST, DBACK_DB_PORT, DBACK_DB_USER, DBACK_DB_PASSWORD, DBACK_DB_NAME
